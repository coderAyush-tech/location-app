# Backend origin. Leave empty only when frontend and API share the same origin.
VITE_API_BASE_URL=https://your-backend.example.com

# Optional overrides for the new photo-session integration.
VITE_PHOTO_SESSIONS_PATH=/api/v1/photo-sessions
VITE_API_TIMEOUT_MS=20000

# Optional local development proxy override.
VITE_DEV_API_PROXY=http://localhost:8080
